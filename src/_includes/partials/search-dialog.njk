{# Site search over the Pagefind index built into /pagefind/ (see
   eleventy.config.js). Mounted once in the base layout, outside the content
   region the router swaps, so it survives page changes.
   Driven by scripts/components/search.js. #}
<dialog class="search" data-search aria-label="Search the docs">
  <div class="search__panel">
    <form class="search__form" role="search" data-search-form>
      {% icon "search" %}
      <input class="search__input" type="search" placeholder="Search the docs…" autocomplete="off"
        autocapitalize="off" spellcheck="false" aria-label="Search the docs" data-search-input />
      <button class="search__close" type="button" aria-label="Close" data-search-close>{% icon "x" %}</button>
    </form>
    <p class="search__status" aria-live="polite" data-search-status>Type to search the docs.</p>
    <ol class="search__results" data-search-results></ol>
    <p class="search__hint">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>Esc</kbd> close</span>
    </p>
  </div>
</dialog>
