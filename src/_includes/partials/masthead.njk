{# Persistent frame: unchanged on every page, kept mounted by the router. #}
<header class="masthead">
  <div class="container">
    <a class="masthead__brand" href="/">
      <img class="masthead__logo logo--spin" src="/assets/images/logo.png" alt="" />
      <img class="masthead__wordmark" src="/assets/images/wordmark.png" alt="{{ site.name }}" />
    </a>

    {# Slogan, parked for now:
    <p class="masthead__title">
      {{ site.slogan.lead }} <span class="text-accent">{{ site.slogan.accent }}</span>
    </p>
    #}

    <p class="lead lead--strong">
      A <strong>code-first</strong>, <strong>code-once</strong> and <strong>code-only</strong> platform<br />
      for AI-assisted test development and orchestration.
    </p>
    <dl class="principles">
      <div class="principles__item">
        <dt class="principles__term">Code-first</dt>
        <dd class="principles__desc">Suites, groups, tests, flows and steps are all defined in Python, so the exact
          same code runs unchanged through the GUI, CLI and CI.</dd>
      </div>
      <div class="principles__item">
        <dt class="principles__term">Code-once</dt>
        <dd class="principles__desc">Write a test suite once, then re-run it with different settings, endpoints or
          dimensions - without touching the code.</dd>
      </div>
      <div class="principles__item">
        <dt class="principles__term">Code-only</dt>
        <dd class="principles__desc">No JSON, no YAML, no configuration layers - everything is defined in Python, 
          including test configuration widgets in the GUI, generated dynamically from the code.</dd>
      </div>
    </dl>

    {% include "partials/nav.njk" %}
  </div>
</header>
