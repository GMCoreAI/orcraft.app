---
layout: layouts/base.njk
title: Account
key: account
noindex: true
description: "Your Orcraft account."
---

<section class="section container container--narrow account"
  data-clerk-publishable-key="{{ account.clerkPublishableKey }}"
  data-clerk-frontend-api="{{ account.clerkFrontendApi }}">
  <h1>Account</h1>
  <p class="text-muted" data-account-lead>Loading your account…</p>

  <div class="card stack" data-account-card hidden>
    <p>Signed in as <strong data-account-email></strong>.</p>
    <p class="text-muted">Plan, machines, members and billing appear here as they are built.</p>
    <div>
      <button class="button button--ghost" type="button" data-account-signout>Sign out</button>
    </div>
  </div>
</section>
