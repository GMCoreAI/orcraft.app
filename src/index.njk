---
layout: layouts/base.njk
key: home
---

<h1 class="visually-hidden">Orcraft — test orchestration platform</h1>

<!-- Evaluation -->
<section class="section container text-center">
  <h2 class="section__title">Try it now with just:</h2>
  <div class="install">
    <code class="install__command">pip install orcraft</code>
    <button class="button button--ghost install__copy" type="button" data-copy="pip install orcraft">Copy</button>
  </div>
</section>

<!-- Product preview -->
<section class="section container">
  <h2 class="section__title">How it works</h2>
  <div class="home-preview">
    <article class="card card--panel reveal">
      <button class="card__shot" type="button" data-lightbox aria-label="Enlarge screenshot">
        <img src="/assets/images/screenshots/build-tests.png"
          alt="Orcraft controller generating a test suite" loading="lazy" />
      </button>
      <h3 class="card__title">Generate tests</h3>
      <p class="card__text">Generate a whole test suite with AI from any documentation sources.</p>
    </article>
    <article class="card card--panel reveal">
      <button class="card__shot" type="button" data-lightbox aria-label="Enlarge screenshot">
        <img src="/assets/images/screenshots/configure-run.png"
          alt="Orcraft run configuration for GUI, CLI and CI" loading="lazy" />
      </button>
      <h3 class="card__title">Configure for GUI, CLI or CI run</h3>
      <p class="card__text">One configuration covers all three — no extra config files, scripts or plugins to maintain.</p>
    </article>
    <article class="card card--panel reveal">
      <button class="card__shot" type="button" data-lightbox aria-label="Enlarge screenshot">
        <img src="/assets/images/screenshots/run-across-endpoints.png"
          alt="Orcraft controller running a session across endpoints" loading="lazy" />
      </button>
      <h3 class="card__title">Run across endpoints</h3>
      <p class="card__text">Queue a session and fan its cases out to local, remote and shared endpoints.</p>
    </article>
    <article class="card card--panel reveal">
      <button class="card__shot" type="button" data-lightbox aria-label="Enlarge screenshot">
        <img src="/assets/images/screenshots/logs-and-results.png"
          alt="Orcraft test group results with per-endpoint detail" loading="lazy" />
      </button>
      <h3 class="card__title">Logs &amp; results</h3>
      <p class="card__text">Follow every case live, then dig into per-endpoint results, reports and session history.</p>
    </article>
  </div>
</section>

<!-- Core capabilities -->
<section class="section container">
  <h2 class="section__title">Core capabilities</h2>
  <div class="grid grid--6">
    <article class="card card--feature">
      <span class="card__icon">{% icon "code" %}</span>
      <h3 class="card__title">Test development</h3>
      <p class="card__text">Suites, groups, tests, cases, flows and steps — all plain Python, versioned with your code.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "hierarchy" %}</span>
      <h3 class="card__title">Execution orchestration</h3>
      <p class="card__text">Build a run plan, queue sessions and execute cases in parallel across endpoints.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "terminal-2" %}</span>
      <h3 class="card__title">GUI + CLI + CI</h3>
      <p class="card__text">Drive the same suites from the controller, the command line or a CI pipeline.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "world" %}</span>
      <h3 class="card__title">Remote &amp; shared endpoints</h3>
      <p class="card__text">Reserve machines in the lab, upload your package and run against real hardware.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "file-analytics" %}</span>
      <h3 class="card__title">Logs &amp; results</h3>
      <p class="card__text">Live logs, aggregated pass/fail figures and exportable reports for every session.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "shield-lock" %}</span>
      <h3 class="card__title">Security</h3>
      <p class="card__text">mTLS between controller and endpoints, with token-based access control.</p>
    </article>
  </div>
</section>

<!-- Audience / platforms -->
<section class="section container">
  <div class="home-audience">
    <div class="card">
      <h2 class="section__title">Built for engineering teams</h2>
      <ul class="audience-list">
        <li><span class="card__icon">{% icon "flask" %}</span>Validation labs</li>
        <li><span class="card__icon">{% icon "cpu" %}</span>Hardware + software testing</li>
        <li><span class="card__icon">{% icon "devices" %}</span>Cross-platform automation</li>
        <li><span class="card__icon">{% icon "infinity" %}</span>CI execution</li>
      </ul>
    </div>
    <div class="card">
      <h2 class="section__title">Supported operating systems</h2>
      <ul class="audience-list audience-list--row">
        <li><span class="card__icon">{% icon "brand-windows" %}</span>Windows</li>
        <li><span class="card__icon">{% icon "brand-ubuntu" %}</span>Linux</li>
        <li><span class="card__icon">{% icon "brand-apple" %}</span>macOS</li>
      </ul>
    </div>
  </div>
</section>
