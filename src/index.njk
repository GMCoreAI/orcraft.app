{# Search body: this page is indexed alongside the docs so capabilities and
   "how it works" are findable from anywhere. Titled "Home" in results. #}
<div data-pagefind-body data-pagefind-meta="title:Home">
<h1 class="visually-hidden">Orcraft: test orchestration platform</h1>

<!-- Headaches -->
<section class="band band--tight">
  <div class="container">
  <h2 id="headaches-solved" class="section__title section__title--caps"><span class="text-danger">Headaches</span>, <span class="text-success">solved</span></h2>
  <ul class="solved" aria-label="Testing headaches and how Orcraft solves them">
    <li class="solved__head" aria-hidden="true">
      <span><img class="solved__figure" src="/assets/images/headaches/headache.png" alt="" /></span>
      <span><img class="solved__figure" src="/assets/images/headaches/solved.png" alt="" /></span>
    </li>
    <li class="solved__row reveal">
      <span class="solved__pain"><span class="solved__mark">{% icon "mood-sad" %}</span>Writing a test suite from a blank page</span>
      <span class="solved__fix"><span class="solved__mark">{% icon "mood-smile" %}</span>AI generates a structured, ready-to-run test suite from documentation.</span>
    </li>
    <li class="solved__row reveal">
      <span class="solved__pain"><span class="solved__mark">{% icon "mood-sad" %}</span>Config files, scripts and plugins to maintain</span>
      <span class="solved__fix"><span class="solved__mark">{% icon "mood-smile" %}</span>The Python suite is the whole config. The GUI is generated from it.</span>
    </li>
    <li class="solved__row reveal">
      <span class="solved__pain"><span class="solved__mark">{% icon "mood-sad" %}</span>Copying tests and tools to every lab machine</span>
      <span class="solved__fix"><span class="solved__mark">{% icon "mood-smile" %}</span>The controller uploads the packages and updates the endpoint.</span>
    </li>
    <li class="solved__row reveal">
      <span class="solved__pain"><span class="solved__mark">{% icon "mood-sad" %}</span>Hand-written parameter combinations</span>
      <span class="solved__fix"><span class="solved__mark">{% icon "mood-smile" %}</span>Dimensions expand one test into a planned case matrix.</span>
    </li>
    <li class="solved__row reveal">
      <span class="solved__pain"><span class="solved__mark">{% icon "mood-sad" %}</span>GUI runs that behave differently in CI</span>
      <span class="solved__fix"><span class="solved__mark">{% icon "mood-smile" %}</span>One suite. An exported snapshot reproduces the run exactly.</span>
    </li>
    <li class="solved__row reveal">
      <span class="solved__pain"><span class="solved__mark">{% icon "mood-sad" %}</span>Tallying results by hand</span>
      <span class="solved__fix"><span class="solved__mark">{% icon "mood-smile" %}</span>Statistics counts roll up automatically, from test case to suite.</span>
    </li>
    <li class="solved__row reveal">
      <span class="solved__pain"><span class="solved__mark">{% icon "mood-sad" %}</span>Logs on every machine, results collected by hand</span>
      <span class="solved__fix"><span class="solved__mark">{% icon "mood-smile" %}</span>One place: live logs, step-level results, spreadsheet export, AI analysis.</span>
    </li>
  </ul>
  </div>
</section>

<!-- Evaluation -->
<section class="section--tight container text-center">
  <h2 id="try-it-now" class="section__title section__title--caps">Try it now</h2>
  <div class="install">
    <code class="install__command">pip install orcraft</code>
    <button class="button button--ghost install__copy" type="button" data-copy="pip install orcraft"
      aria-label="Copy command" title="Copy command">
      <span class="install__copy-idle">{% icon "copy" %}</span>
      <span class="install__copy-done">{% icon "check" %}</span>
    </button>
  </div>
  <p class="text-muted" style="margin-top: var(--space-8); margin-bottom: 0;">See <a class="text-accent" href="/setup/">Setup</a> for details</p>
</section>

<!-- Product preview -->
<section class="band">
  <div class="container container--wide">
    <h2 id="how-it-works" class="section__title section__title--caps">How it works</h2>
    <div class="home-preview">
    <article class="card card--panel reveal">
      <button class="card__shot" type="button" data-lightbox aria-label="Enlarge screenshot">
        <img src="/assets/images/screenshots/home/build-tests.png"
          alt="Orcraft controller generating a test suite" loading="lazy" />
      </button>
      <h3 id="develop-tests-ai-assisted" class="card__title">Develop tests <span class="badge badge--ai">AI-assisted</span></h3>
      <p class="card__text">Develop test suites manually based on the <a class="text-accent" href="/framework/">Framework</a> documentation, or generate a complete or partial suite using AI from the existing documentation sources of the system under test.</p>
    </article>
    <article class="card card--panel reveal">
      <button class="card__shot" type="button" data-lightbox aria-label="Enlarge screenshot">
        <img src="/assets/images/screenshots/home/configure-run.png"
          alt="Orcraft run configuration for GUI, CLI and CI" loading="lazy" />
      </button>
      <h3 id="configure-the-run" class="card__title">Configure the run</h3>
      <p class="card__text">Run with defaults from the CLI or CI. Or configure the run through GUI widgets auto-generated from the code, including target endpoints selection, with no additional configuration files, scripts or plugins to maintain.</p>
    </article>
    <article class="card card--panel reveal">
      <button class="card__shot" type="button" data-lightbox aria-label="Enlarge screenshot">
        <img src="/assets/images/screenshots/home/run-across-endpoints.png"
          alt="Orcraft controller running a session across endpoints" loading="lazy" />
      </button>
      <h3 id="run-from-gui-cli-or-ci" class="card__title">Run from GUI, CLI or CI</h3>
      <p class="card__text">Execute entirely from the GUI, following the configurable test plan. Or confirm everything works from the GUI, then export the same working configuration to run unattended from the CLI or CI.</p>
    </article>
    <article class="card card--panel reveal">
      <button class="card__shot" type="button" data-lightbox aria-label="Enlarge screenshot">
        <img src="/assets/images/screenshots/home/logs-and-results.png"
          alt="Orcraft test group results with per-endpoint detail" loading="lazy" />
      </button>
      <h3 id="analyze-results-ai-assisted" class="card__title">Analyze results <span class="badge badge--ai">AI-assisted</span></h3>
      <p class="card__text">Structured reports down to the test step level, with spreadsheet export, then turned into an AI-assisted analysis: failures, recurring patterns across endpoints and versions, and recommended actions.</p>
    </article>
    </div>
  </div>
</section>

<!-- Core capabilities -->
<section class="section container">
  <h2 id="core-capabilities" class="section__title section__title--caps">Core capabilities</h2>
  <div class="capabilities">
    <article class="card card--feature">
      <span class="card__icon">{% icon "code" %}</span>
      <h3 id="test-development-framework" class="card__title">Test development framework</h3>
      <p class="card__text"><a class="text-accent" href="/framework/#component-model">A defined structure</a>, generated by AI or written manually: suites, groups, tests, cases, flows and steps in plain Python.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "variable" %}</span>
      <h3 id="parametrized-cases" class="card__title">Parametrized cases</h3>
      <p class="card__text"><a class="text-accent" href="/tutorial/matrix-and-cases/">Dimensions</a> expand a test into a case matrix, executed in defined or randomized order over configurable cycles.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "hierarchy" %}</span>
      <h3 id="execution-orchestration" class="card__title">Execution orchestration</h3>
      <p class="card__text">Configure tests via a <a class="text-accent" href="/tutorial/basic-configuration-parameters-group/">dynamically generated GUI</a> from Python code. Build run plans, queue tests and execute them in parallel across endpoints.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "terminal-2" %}</span>
      <h3 id="gui-cli-ci" class="card__title">GUI + CLI + CI</h3>
      <p class="card__text"><a class="text-accent" href="/setup/">Run the same suites</a> from the controller, the command line or a CI pipeline.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "world" %}</span>
      <h3 id="remote-and-shared-endpoints" class="card__title">Remote &amp; shared endpoints</h3>
      <p class="card__text"><a class="text-accent" href="/setup/endpoints/">An agent</a> on remote machines, sharable across the team. The developer defines the target endpoints placeholders per test step.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "share-3" %}</span>
      <h3 id="automatic-upload-and-updates" class="card__title">Automatic upload &amp; updates</h3>
      <p class="card__text">Orcraft uploads the test package to each endpoint and updates its software whenever versions differ.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "file-analytics" %}</span>
      <h3 id="centralized-logs-and-results" class="card__title">Centralized logs &amp; results</h3>
      <p class="card__text">All run data is centralized in one place: <a class="text-accent" href="/tutorial/running-hello-world-test/#test-log">live logs</a>, aggregated results, and detailed step-level statuses.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "file-spreadsheet" %}</span>
      <h3 id="reports-and-export" class="card__title">Reports &amp; export</h3>
      <p class="card__text">Analyze any run with AI, then export the results to <a class="text-accent" href="/tutorial/running-a-group/#group-details">structured spreadsheets</a> or portable session files.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "history" %}</span>
      <h3 id="sessions-and-history" class="card__title">Sessions &amp; history</h3>
      <p class="card__text">Sessions are saved, reopened later and <a class="text-accent" href="/tutorial/editing-run-configuration/#rerunning-test-runs">re-executed with the same plan</a>.</p>
    </article>
    <article class="card card--feature">
      <span class="card__icon">{% icon "shield-lock" %}</span>
      <h3 id="secure-connection" class="card__title">Secure connection</h3>
      <p class="card__text">Optional <a class="text-accent" href="/setup/endpoints/#secure-endpoint-connection">mTLS</a> between controller and endpoints, with token-based access control.</p>
    </article>
  </div>
</section>

